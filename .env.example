# ============================================================================
# Database (Supabase Postgres in production)
# ============================================================================
# Leaving DATABASE_URL empty will crash dev: Prisma + Auth.js need a real URL.
#
# Local PostgreSQL (Homebrew, Postgres.app, or a system install):
#   1) Ensure Postgres is running on port 5432.
#   2) Create a database, e.g. `createdb searcher` (or use psql / a GUI).
#   3) Set both URLs to the same connection string unless you use PgBouncer locally.
#
# Typical URL shape (replace user, password, and database name):
#   postgresql://USER:PASSWORD@127.0.0.1:5432/searcher
#
# If your OS user is the DB superuser (common on Homebrew), this often works:
#   postgresql://YOUR_OS_USERNAME@127.0.0.1:5432/searcher
#
# If you created a `postgres` role (Linux-style), use:
#   postgresql://postgres:PASSWORD@127.0.0.1:5432/searcher
#
# Production (Supabase):
#   DATABASE_URL = pooled (PgBouncer), e.g. …pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct host, e.g. …db.<ref>.supabase.co:5432/postgres

# Prisma CLI does not load .env.local by default. Use npm scripts so DB commands pick it up:
#   npm run db:push   npm run db:migrate   npm run db:studio

DATABASE_URL=
DIRECT_URL=

# ============================================================================
# Auth.js (NextAuth v5)
# ============================================================================
# `openssl rand -base64 32`
AUTH_SECRET=

# Public app URL (used by Auth.js for callbacks).
# Local: http://localhost:3000  ·  Prod: https://your-domain.com
AUTH_URL=http://localhost:3000

# Required behind some reverse proxies / preview deployments.
AUTH_TRUST_HOST=true

# ============================================================================
# GitHub OAuth (https://github.com/settings/developers)
# Authorization callback URL: ${AUTH_URL}/api/auth/callback/github
# ============================================================================
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ============================================================================
# Vercel AI Gateway
# https://vercel.com/docs/ai-gateway
# ============================================================================
AI_GATEWAY_API_KEY=

# ============================================================================
# Job aggregator APIs (optional; only required for those providers)
# ============================================================================
# Adzuna https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
