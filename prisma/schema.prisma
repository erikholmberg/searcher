// Searcher — Prisma schema
// Postgres (Supabase in prod). DATABASE_URL = pooled (PgBouncer), DIRECT_URL = direct.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Auth.js (NextAuth v5) — Prisma adapter required tables
// https://authjs.dev/getting-started/adapters/prisma
// ============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // App-specific identity. GitHub OAuth profile id (stringified) for stable linkage.
  githubId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  roleTypes RoleType[]
  jobStates UserJobState[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// Domain
// ============================================================================

enum WorkMode {
  remote
  hybrid
  onsite
  unknown
}

// A user-defined bucket like "Staff backend" or "ML infra".
model RoleType {
  id        String  @id @default(cuid())
  userId    String
  name      String
  sortOrder Int     @default(0)
  // Optional free-text "what 'similar' means here", used for AI assist/scoring.
  intent    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources RoleTypeSource[]
  jobs    RoleTypeJob[]
  dismissedJobs RoleTypeDismissedJob[]

  @@index([userId])
}

// Jobs removed from a role type by the user; ingest skips these externalIds for this bucket.
model RoleTypeDismissedJob {
  id         String   @id @default(cuid())
  roleTypeId String
  externalId String
  createdAt  DateTime @default(now())

  roleType RoleType @relation(fields: [roleTypeId], references: [id], onDelete: Cascade)

  @@unique([roleTypeId, externalId])
  @@index([roleTypeId])
}

// Provider-specific source attached to a RoleType.
// `kind` discriminates the shape of `config` and `paginationState`.
enum SourceKind {
  adzuna_query
  arbeitnow_query
  remotive_query
  greenhouse_board
  lever_board
  ashby_board
}

model RoleTypeSource {
  id         String     @id @default(cuid())
  roleTypeId String
  kind       SourceKind

  // Provider-specific config (keywords, location, remoteOnly, board token, etc).
  config Json

  // Provider-specific cursor (page/offset/cursor). Updated by `find-more`.
  paginationState Json?

  // Last successful fetch timestamp (informational for UI).
  lastFetchedAt DateTime?

  // Last error message (for UI surface; cleared on next success).
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleType RoleType @relation(fields: [roleTypeId], references: [id], onDelete: Cascade)

  @@index([roleTypeId])
}

// A normalized job posting from any provider/ATS. Globally unique by externalId.
model JobListing {
  id                 String    @id @default(cuid())
  // Stable identity: `${source}:${providerJobId or canonicalUrl}`.
  externalId         String    @unique
  source             String
  title              String
  company            String
  url                String
  descriptionSnippet String?   @db.Text
  postedAt           DateTime?
  locationDisplay    String?
  workMode           WorkMode  @default(unknown)

  // Optional raw payload for debugging / future enrichment.
  payload Json?

  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleTypes  RoleTypeJob[]
  userStates UserJobState[]

  @@index([source])
  @@index([postedAt])
}

// Join table: which JobListings have been surfaced for which RoleType.
// Unique (roleTypeId, jobListingId) makes `find-more` and `refresh` idempotent.
model RoleTypeJob {
  id           String   @id @default(cuid())
  roleTypeId   String
  jobListingId String

  // Which source on this role type surfaced this job (informational).
  sourceId String?

  // Optional AI relevance score; null until scored.
  matchScore Float?

  addedAt DateTime @default(now())

  roleType   RoleType   @relation(fields: [roleTypeId], references: [id], onDelete: Cascade)
  jobListing JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@unique([roleTypeId, jobListingId])
  @@index([roleTypeId])
  @@index([jobListingId])
}

// Per-user state for a JobListing: favorited / hidden, persisted across sessions.
model UserJobState {
  id           String  @id @default(cuid())
  userId       String
  jobListingId String
  favorite     Boolean @default(false)
  hidden       Boolean @default(false)

  favoritedAt DateTime?
  hiddenAt    DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListing JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)

  @@unique([userId, jobListingId])
  @@index([userId, favorite])
  @@index([userId, hidden])
}
